{% layout none %}
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    {%- assign formatted_balance = gift_card.balance | money -%}
    <title>{{ 'gift_cards.issued.title' | t: value: formatted_balance, shop: shop.name }}</title>
    <meta name="description" content="{{ 'gift_cards.issued.subtext' | t }}">
    {% render 'theme-styles' %}
    {{ 'base.css' | asset_url | stylesheet_tag }}
    {{ 'presets.css' | asset_url | stylesheet_tag }}
    <script src="{{ 'vendor/qrcode.js' | shopify_asset_url }}" defer="defer"></script>
    {{ content_for_header }}
  </head>
  <body class="style-{{ settings.style_preset }} template-gift-card">
    <main id="MainContent" class="section">
      <div class="container container--narrow gift-card">
        <p class="brand"><span class="brand__mark" aria-hidden="true"></span><span class="brand__name">{{ shop.name | escape }}</span></p>
        <h1 class="section__title">{{ 'gift_cards.issued.subtext' | t }}</h1>
        <div class="gift-card__card">
          <p class="gift-card__balance">{{ gift_card.balance | money }}</p>
          {%- if gift_card.balance != gift_card.initial_value -%}
            {%- assign initial_value = gift_card.initial_value | money -%}
            <p>{{ 'gift_cards.issued.initial_value' | t: value: initial_value }}</p>
          {%- endif -%}
          {%- if gift_card.enabled == false -%}
            <p class="badge badge--muted">{{ 'gift_cards.issued.disabled' | t }}</p>
          {%- elsif gift_card.expires_on -%}
            {%- assign expiry = gift_card.expires_on | date: format: 'date' -%}
            {%- if gift_card.expired -%}
              <p class="badge badge--muted">{{ 'gift_cards.issued.expired' | t: expiry: expiry }}</p>
            {%- else -%}
              <p>{{ 'gift_cards.issued.active' | t: expiry: expiry }}</p>
            {%- endif -%}
          {%- endif -%}
          <label for="GiftCardCode" class="visually-hidden">{{ 'gift_cards.issued.code_label' | t }}</label>
          <input id="GiftCardCode" class="gift-card__code" type="text" value="{{ gift_card.code | format_code }}" readonly onclick="this.select();">
          <div id="QrCode" class="gift-card__qr" data-identifier="{{ gift_card.qr_identifier }}" aria-label="{{ 'gift_cards.issued.qr_image_alt' | t }}" role="img"></div>
          {%- if gift_card.pass_url -%}
            <a href="{{ gift_card.pass_url }}" class="gift-card__wallet">
              <img src="{{ 'gift-card/add-to-apple-wallet.svg' | shopify_asset_url }}" width="120" height="40" alt="{{ 'gift_cards.issued.add_to_apple_wallet' | t }}" loading="lazy">
            </a>
          {%- endif -%}
        </div>
        <p class="actions">
          <a class="btn btn--primary" href="{{ shop.url }}" target="_blank" rel="noopener">{{ 'gift_cards.issued.shop_link' | t }}</a>
          <button type="button" class="btn btn--ghost" onclick="window.print();">{{ 'gift_cards.issued.print_gift_card' | t }}</button>
        </p>
      </div>
    </main>
    <script>
      window.addEventListener('load', function () {
        var el = document.getElementById('QrCode');
        if (window.QRCode && el) new QRCode(el, { text: el.dataset.identifier, width: 120, height: 120, imageAltText: el.getAttribute('aria-label') });
      });
    </script>
  </body>
</html>
