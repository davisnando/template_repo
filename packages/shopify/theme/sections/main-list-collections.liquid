<section class="section color-{{ section.settings.color_scheme }}">
  <div class="container">
    <div class="section__head"><h1 class="section__title">{{ section.settings.title | escape }}</h1></div>
    {%- paginate collections by 24 -%}
      <ul class="product-grid" role="list">
        {%- for collection in collections -%}
          <li class="card">
            <a class="card__link" href="{{ collection.url }}">
              <div class="card__media">
                {%- if collection.featured_image -%}
                  {{ collection.featured_image | image_url: width: 800 | image_tag: loading: 'lazy', widths: '300, 400, 600, 800', sizes: '(min-width: 990px) 25vw, 50vw' }}
                {%- else -%}
                  {{ 'collection-1' | placeholder_svg_tag: 'placeholder' }}
                {%- endif -%}
              </div>
              <h2 class="card__title">{{ collection.title | escape }}</h2>
            </a>
          </li>
        {%- endfor -%}
      </ul>
      {% render 'pagination', paginate: paginate %}
    {%- endpaginate -%}
  </div>
</section>

{% schema %}
{
  "name": "Collections list",
  "tag": "div",
  "class": "section-main-list-collections",
  "settings": [
    { "type": "text", "id": "title", "label": "Heading", "default": "Collections" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" }
  ]
}
{% endschema %}
