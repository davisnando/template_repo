<section class="section password color-{{ section.settings.color_scheme }}">
  <div class="container container--narrow password__inner">
    <p class="brand"><span class="brand__mark" aria-hidden="true"></span><span class="brand__name">{{ shop.name | escape }}</span></p>
    <h1 class="section__title">{{ section.settings.heading | escape }}</h1>
    {%- if shop.password_message != blank -%}<p class="section__intro">{{ shop.password_message }}</p>{%- endif -%}

    {%- form 'customer', id: 'PasswordNewsletter', class: 'newsletter-form' -%}
      <input type="hidden" name="contact[tags]" value="prospect,password page">
      <div class="field">
        <label for="PasswordNewsletter-email">{{ 'newsletter.label' | t }}</label>
        <input id="PasswordNewsletter-email" type="email" name="contact[email]" autocomplete="email" required>
      </div>
      <button type="submit" class="btn btn--primary">{{ 'newsletter.button' | t }}</button>
      {%- if form.posted_successfully? -%}<p class="form__ok" role="status">{{ 'newsletter.success' | t }}</p>{%- endif -%}
      {%- if form.errors -%}<p class="form__error" role="alert">{{ form.errors.messages.email }}</p>{%- endif -%}
    {%- endform -%}

    <details class="accordion password__login">
      <summary>{{ 'templates.password.enter_using_password' | t }}{% render 'icon', icon: 'chevron' %}</summary>
      {%- form 'storefront_password', class: 'password-form' -%}
        {%- if form.errors -%}<div class="form__errors" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
        <div class="field">
          <label for="Password">{{ 'templates.password.password' | t }}</label>
          <input id="Password" type="password" name="password" autocomplete="current-password" required>
        </div>
        <button type="submit" class="btn btn--ghost">{{ 'templates.password.enter' | t }}</button>
      {%- endform -%}
      <p><small>{{ 'templates.password.admin_link_html' | t }}</small></p>
    </details>
    <p><small>{{ 'templates.password.powered_by_shopify_html' | t: shopify: powered_by_link }}</small></p>
  </div>
</section>

{% schema %}
{
  "name": "Password page",
  "tag": "div",
  "class": "section-main-password",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Opening soon" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" }
  ]
}
{% endschema %}
