{%- paginate collection.products by section.settings.products_per_page -%}
  <section class="section collection color-{{ section.settings.color_scheme }}">
    <div class="container">
      <div class="section__head">
        <h1 class="section__title">{{ collection.title | escape }}</h1>
        {%- if collection.description != blank -%}<div class="section__intro rte">{{ collection.description }}</div>{%- endif -%}
      </div>
      {%- if section.settings.enable_filtering -%}
        {% render 'facets', results: collection, clear_url: collection.url %}
      {%- endif -%}
      {%- if collection.products.size > 0 -%}
        <ul class="product-grid" role="list">
          {%- for product in collection.products -%}
            {%- liquid
              assign lazy = true
              if forloop.index <= 4
                assign lazy = false
              endif
            -%}
            <li>{% render 'product-card', product: product, lazy: lazy %}</li>
          {%- endfor -%}
        </ul>
      {%- else -%}
        <p class="empty-state">{{ 'collections.empty' | t }} <a href="{{ collection.url }}">{{ 'products.facets.clear_all' | t }}</a></p>
      {%- endif -%}
      {% render 'pagination', paginate: paginate %}
    </div>
  </section>
{%- endpaginate -%}

{% schema %}
{
  "name": "Product grid",
  "tag": "div",
  "class": "section-main-collection",
  "settings": [
    { "type": "range", "id": "products_per_page", "label": "Products per page", "min": 8, "max": 24, "step": 4, "default": 16 },
    { "type": "checkbox", "id": "enable_filtering", "label": "Enable filtering and sorting", "default": true },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" }
  ]
}
{% endschema %}
