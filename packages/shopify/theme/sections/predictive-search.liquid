{%- if predictive_search.performed -%}
  <div class="predictive-search__results" role="listbox">
    {%- if predictive_search.resources.queries.size > 0 -%}
      <h2 class="predictive-search__heading">{{ 'general.search.suggestions' | t }}</h2>
      <ul role="list">
        {%- for query in predictive_search.resources.queries -%}
          <li role="option"><a href="{{ query.url }}">{{ query.styled_text }}</a></li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
    {%- if predictive_search.resources.products.size > 0 -%}
      <h2 class="predictive-search__heading">{{ 'general.search.products' | t }}</h2>
      <ul role="list" class="predictive-search__products">
        {%- for product in predictive_search.resources.products -%}
          <li role="option">
            <a href="{{ product.url }}">
              {%- if product.featured_media -%}
                {{ product.featured_media | image_url: width: 120 | image_tag: loading: 'lazy', alt: product.featured_media.alt }}
              {%- endif -%}
              <span>{{ product.title | escape }}</span>
              {% render 'price', product: product %}
            </a>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
    {%- if predictive_search.resources.pages.size > 0 -%}
      <h2 class="predictive-search__heading">{{ 'general.search.pages' | t }}</h2>
      <ul role="list">
        {%- for item in predictive_search.resources.pages -%}
          <li role="option"><a href="{{ item.url }}">{{ item.title | escape }}</a></li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
    {%- if predictive_search.resources.articles.size > 0 -%}
      <h2 class="predictive-search__heading">{{ 'general.search.articles' | t }}</h2>
      <ul role="list">
        {%- for item in predictive_search.resources.articles -%}
          <li role="option"><a href="{{ item.url }}">{{ item.title | escape }}</a></li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
    {%- if predictive_search.resources.collections.size > 0 -%}
      <h2 class="predictive-search__heading">{{ 'general.search.collections' | t }}</h2>
      <ul role="list">
        {%- for item in predictive_search.resources.collections -%}
          <li role="option"><a href="{{ item.url }}">{{ item.title | escape }}</a></li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
    <a class="predictive-search__all" href="{{ routes.search_url }}?q={{ predictive_search.terms | url_encode }}&options[prefix]=last">{{ 'general.search.search_for' | t: terms: predictive_search.terms }}</a>
  </div>
{%- endif -%}
