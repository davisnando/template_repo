<section class="section color-{{ section.settings.color_scheme }}">
  <div class="container container--narrow">
    <p class="eyebrow">404</p>
    <h1 class="section__title">{{ 'templates.404.title' | t }}</h1>
    <p class="section__intro">{{ 'templates.404.subtext' | t }}</p>
    <p class="actions"><a class="btn btn--primary" href="{{ routes.all_products_collection_url }}">{{ 'general.continue_shopping' | t }}</a></p>
  </div>
</section>

{% schema %}
{
  "name": "404",
  "tag": "div",
  "class": "section-main-404",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" }
  ]
}
{% endschema %}
