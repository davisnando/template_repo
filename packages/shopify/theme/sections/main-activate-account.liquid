<section class="section customer color-{{ section.settings.color_scheme }}">
  <div class="container container--narrow">
    <h1 class="section__title">{{ 'customer.activate_account.title' | t }}</h1>
    <p>{{ 'customer.activate_account.subtext' | t }}</p>
    {%- form 'activate_customer_password', class: 'customer__form' -%}
      {%- if form.errors -%}<div class="form__errors" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
      <div class="field"><label for="ActivatePassword">{{ 'customer.login.password' | t }}</label><input id="ActivatePassword" type="password" name="customer[password]" autocomplete="new-password" required></div>
      <div class="field"><label for="ActivatePasswordConfirm">{{ 'customer.activate_account.password_confirm' | t }}</label><input id="ActivatePasswordConfirm" type="password" name="customer[password_confirmation]" autocomplete="new-password" required></div>
      <button type="submit" class="btn btn--primary">{{ 'customer.activate_account.submit' | t }}</button>
      <button type="submit" name="decline" class="btn btn--ghost">{{ 'customer.activate_account.cancel' | t }}</button>
    {%- endform -%}
  </div>
</section>

{% schema %}
{
  "name": "Activate account",
  "tag": "div",
  "class": "section-main-activate-account",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" }
  ]
}
{% endschema %}
