<footer class="site-footer color-{{ section.settings.color_scheme }}">
  <div class="container site-footer__inner">
    {%- for block in section.blocks -%}
      <div class="site-footer__block site-footer__block--{{ block.type }}" {{ block.shopify_attributes }}>
        {%- case block.type -%}
          {%- when 'brand' -%}
            <a class="brand" href="{{ routes.root_url }}"><span class="brand__mark" aria-hidden="true"></span><span class="brand__name">{{ shop.name | escape }}</span></a>
            {%- if block.settings.text != blank -%}<div class="rte">{{ block.settings.text }}</div>{%- endif -%}
            {%- if block.settings.show_social -%}{% render 'social-icons' %}{%- endif -%}
          {%- when 'menu' -%}
            <h2>{{ block.settings.heading | escape }}</h2>
            <ul class="footer-nav" role="list">
              {%- for link in block.settings.menu.links -%}
                <li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>
              {%- endfor -%}
            </ul>
          {%- when 'text' -%}
            <h2>{{ block.settings.heading | escape }}</h2>
            <div class="rte">{{ block.settings.text }}</div>
          {%- when 'newsletter' -%}
            <h2>{{ block.settings.heading | escape }}</h2>
            {%- form 'customer', id: 'FooterNewsletter', class: 'newsletter-form' -%}
              <input type="hidden" name="contact[tags]" value="newsletter">
              <div class="field">
                <label for="FooterNewsletter-email">{{ 'newsletter.label' | t }}</label>
                <input id="FooterNewsletter-email" type="email" name="contact[email]" autocomplete="email" required
                  {%- if form.errors %} aria-invalid="true" aria-describedby="FooterNewsletter-error"{% endif %}>
              </div>
              <button type="submit" class="btn btn--primary">{{ 'newsletter.button' | t }}</button>
              {%- if form.errors -%}
                <p id="FooterNewsletter-error" class="form__error" role="alert">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>
              {%- endif -%}
              {%- if form.posted_successfully? -%}
                <p class="form__ok" role="status">{{ 'newsletter.success' | t }}</p>
              {%- endif -%}
            {%- endform -%}
        {%- endcase -%}
      </div>
    {%- endfor -%}
  </div>
  <div class="container site-footer__legal">
    {% render 'localization-form', show_country: section.settings.show_country, show_language: section.settings.show_language, id: 'FooterLocalization' %}
    {%- if section.settings.show_payment_icons and shop.enabled_payment_types.size > 0 -%}
      <ul class="payment-icons" role="list">
        <li class="visually-hidden">{{ 'general.payment_methods' | t }}</li>
        {%- for type in shop.enabled_payment_types -%}
          <li>{{ type | payment_type_svg_tag: class: 'payment-icon' }}</li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
    <p>&copy; {{ 'now' | date: '%Y' }} {{ shop.name | link_to: routes.root_url }}. {{ powered_by_link }}</p>
    {%- if section.settings.show_policies -%}
      <ul class="policies" role="list">
        {%- for policy in shop.policies -%}
          {%- if policy != blank -%}
            <li><a href="{{ policy.url }}">{{ policy.title | escape }}</a></li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "tag": "div",
  "class": "section-footer",
  "enabled_on": { "groups": ["footer"] },
  "max_blocks": 5,
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-3" },
    { "type": "checkbox", "id": "show_country", "label": "Show country/region selector", "default": true },
    { "type": "checkbox", "id": "show_language", "label": "Show language selector", "default": true },
    { "type": "checkbox", "id": "show_payment_icons", "label": "Show payment icons", "default": true },
    { "type": "checkbox", "id": "show_policies", "label": "Show policy links", "default": true }
  ],
  "blocks": [
    {
      "type": "brand", "name": "Brand", "limit": 1,
      "settings": [
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Tell customers who you are and what you do.</p>" },
        { "type": "checkbox", "id": "show_social", "label": "Show social links", "default": true }
      ]
    },
    {
      "type": "menu", "name": "Menu",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Explore" },
        { "type": "link_list", "id": "menu", "label": "Menu", "default": "footer" }
      ]
    },
    {
      "type": "text", "name": "Text",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Visit" },
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Add your address and opening hours.</p>" }
      ]
    },
    {
      "type": "newsletter", "name": "Newsletter", "limit": 1,
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Stay in touch" }
      ]
    }
  ]
}
{% endschema %}
