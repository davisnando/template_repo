<section class="section customer color-{{ section.settings.color_scheme }}">
  <div class="container container--narrow">
    <p><a href="{{ routes.account_url }}">&larr; {{ 'customer.account.return' | t }}</a></p>
    <h1 class="section__title">{{ 'customer.addresses.title' | t }}</h1>
    {%- paginate customer.addresses by 10 -%}
      <details class="accordion">
        <summary>{{ 'customer.addresses.add_new' | t }}{% render 'icon', icon: 'chevron' %}</summary>
        {%- form 'customer_address', customer.new_address, class: 'address-form' -%}
          {% render 'address-fields', form: form, id: 'new' %}
          <button type="submit" class="btn btn--primary">{{ 'customer.addresses.add' | t }}</button>
        {%- endform -%}
      </details>
      <ul class="addresses" role="list">
        {%- for address in customer.addresses -%}
          <li>
            {%- if address == customer.default_address -%}<p class="badge">{{ 'customer.addresses.default' | t }}</p>{%- endif -%}
            {{ address | format_address }}
            <details class="accordion">
              <summary>{{ 'customer.addresses.edit' | t }}{% render 'icon', icon: 'chevron' %}</summary>
              {%- form 'customer_address', address, class: 'address-form' -%}
                {% render 'address-fields', form: form, id: address.id %}
                <button type="submit" class="btn btn--primary">{{ 'customer.addresses.update' | t }}</button>
              {%- endform -%}
            </details>
            <form class="address-delete" method="post" action="{{ address.url }}" data-confirm="{{ 'customer.addresses.delete_confirm' | t }}">
              <input type="hidden" name="_method" value="delete">
              <button type="submit" class="btn btn--ghost btn--compact">{{ 'customer.addresses.delete' | t }}</button>
            </form>
          </li>
        {%- endfor -%}
      </ul>
      {% render 'pagination', paginate: paginate %}
    {%- endpaginate -%}
  </div>
</section>

{% schema %}
{
  "name": "Customer addresses",
  "tag": "div",
  "class": "section-main-addresses",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" }
  ]
}
{% endschema %}
