<section class="section customer color-{{ section.settings.color_scheme }}">
  <div class="container container--narrow">
    <p><a href="{{ routes.account_url }}">&larr; {{ 'customer.account.return' | t }}</a></p>
    <h1 class="section__title">{{ 'customer.order.title' | t: name: order.name }}</h1>
    <p>{{ 'customer.order.date_html' | t: date: order.created_at | time_tag: format: 'date_at_time' }}</p>
    {%- if order.cancelled -%}
      <p class="form__error">{{ 'customer.order.cancelled_html' | t: date: order.cancelled_at | time_tag: format: 'date_at_time' }} &ndash; {{ order.cancel_reason_label }}</p>
    {%- endif -%}
    <table class="cart__table">
      <caption class="visually-hidden">{{ 'customer.order.title' | t: name: order.name }}</caption>
      <thead><tr><th scope="col">{{ 'customer.order.product' | t }}</th><th scope="col">{{ 'customer.order.quantity' | t }}</th><th scope="col">{{ 'customer.order.total' | t }}</th></tr></thead>
      <tbody>
        {%- for line_item in order.line_items -%}
          <tr>
            <td>
              {{ line_item.title | link_to: line_item.product.url }}
              {%- if line_item.fulfillment -%}
                <p><small>{{ 'customer.order.fulfilled_at_html' | t: date: line_item.fulfillment.created_at | time_tag: format: 'date' }}
                {%- if line_item.fulfillment.tracking_url %} <a href="{{ line_item.fulfillment.tracking_url }}">{{ 'customer.order.track_shipment' | t }}</a>{% endif -%}</small></p>
              {%- endif -%}
            </td>
            <td>{{ line_item.quantity }}</td>
            <td>{{ line_item.final_line_price | money }}</td>
          </tr>
        {%- endfor -%}
      </tbody>
      <tfoot>
        <tr><th scope="row" colspan="2">{{ 'customer.order.subtotal' | t }}</th><td>{{ order.line_items_subtotal_price | money }}</td></tr>
        {%- for discount_application in order.cart_level_discount_applications -%}
          <tr><th scope="row" colspan="2">{{ 'customer.order.discount' | t }} ({{ discount_application.title | escape }})</th><td>&minus;{{ discount_application.total_allocated_amount | money }}</td></tr>
        {%- endfor -%}
        {%- for shipping_method in order.shipping_methods -%}
          <tr><th scope="row" colspan="2">{{ 'customer.order.shipping' | t }} ({{ shipping_method.title | escape }})</th><td>{{ shipping_method.price | money }}</td></tr>
        {%- endfor -%}
        {%- for tax_line in order.tax_lines -%}
          <tr><th scope="row" colspan="2">{{ 'customer.order.tax' | t }} ({{ tax_line.title | escape }} {{ tax_line.rate | times: 100 }}%)</th><td>{{ tax_line.price | money }}</td></tr>
        {%- endfor -%}
        <tr><th scope="row" colspan="2">{{ 'customer.order.total' | t }}</th><td>{{ order.total_net_amount | money_with_currency }}</td></tr>
      </tfoot>
    </table>
    <div class="account">
      <div><h2>{{ 'customer.order.billing_address' | t }}</h2><p>{{ 'customer.order.payment_status' | t }}: {{ order.financial_status_label }}</p>{{ order.billing_address | format_address }}</div>
      <div><h2>{{ 'customer.order.shipping_address' | t }}</h2><p>{{ 'customer.order.fulfillment_status' | t }}: {{ order.fulfillment_status_label }}</p>{{ order.shipping_address | format_address }}</div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Customer order",
  "tag": "div",
  "class": "section-main-order",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" }
  ]
}
{% endschema %}
