{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign form_id = 'ProductForm-' | append: section.id
-%}
<section class="section product-section color-{{ section.settings.color_scheme }}" data-section="{{ section.id }}" data-product-url="{{ product.url }}">
  <div class="container product">
    <div class="product__media">
      {%- if product.media.size > 0 -%}
        <ul class="product__media-list" role="list">
          {%- for media in product.media -%}
            <li class="product__media-item" data-media-id="{{ media.id }}">
              {%- case media.media_type -%}
                {%- when 'image' -%}
                  {%- if forloop.first -%}{%- assign loading = 'eager' -%}{%- else -%}{%- assign loading = 'lazy' -%}{%- endif -%}
                  {{ media | image_url: width: 1600 | image_tag: loading: loading, widths: '550, 800, 1100, 1600', sizes: '(min-width: 990px) 55vw, 100vw', class: 'product__img' }}
                {%- when 'video', 'external_video' -%}
                  {{ media | media_tag: image_size: '1600x' }}
                {%- when 'model' -%}
                  {{ media | model_viewer_tag: image_size: '1600x', reveal: 'interaction', toggleable: true }}
              {%- endcase -%}
            </li>
          {%- endfor -%}
        </ul>
      {%- else -%}
        {{ 'product-1' | placeholder_svg_tag: 'placeholder' }}
      {%- endif -%}
    </div>

    <div class="product__info">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when '@app' -%}
            {% render block %}

          {%- when 'text' -%}
            <p class="eyebrow" {{ block.shopify_attributes }}>{{ block.settings.text | escape }}</p>

          {%- when 'title' -%}
            <h1 class="section__title product__title" {{ block.shopify_attributes }}>{{ product.title | escape }}</h1>

          {%- when 'price' -%}
            <div class="product__price" id="Price-{{ section.id }}" {{ block.shopify_attributes }}>
              {% render 'price', product: product, use_variant: true %}
            </div>
            {%- if cart.taxes_included or shop.shipping_policy.body != blank -%}
              <p class="product__tax">
                {%- if cart.taxes_included -%}{{ 'products.product.include_taxes' | t }}{%- endif -%}
                {%- if shop.shipping_policy.body != blank %} {{ 'products.product.shipping_policy_html' | t: link: shop.shipping_policy.url }}{%- endif -%}
              </p>
            {%- endif -%}
            {%- assign installments_id = 'ProductInstallments' | append: section.id -%}
            {%- form 'product', product, id: installments_id, class: 'installments' -%}
              <input type="hidden" name="id" value="{{ current_variant.id }}">
              {{ form | payment_terms }}
            {%- endform -%}

          {%- when 'variant_picker' -%}
            {%- unless product.has_only_default_variant -%}
              <div class="variant-picker" data-variant-picker="{{ section.id }}" {{ block.shopify_attributes }}>
                {%- for option in product.options_with_values -%}
                  <div class="field">
                    <label for="Option-{{ section.id }}-{{ forloop.index0 }}">{{ option.name | escape }}</label>
                    <select id="Option-{{ section.id }}-{{ forloop.index0 }}" name="options[{{ option.name | escape }}]" form="{{ form_id }}" data-option-index="{{ forloop.index0 }}">
                      {%- for value in option.values -%}
                        <option value="{{ value | escape }}"{% if option.selected_value == value %} selected{% endif %}>{{ value | escape }}</option>
                      {%- endfor -%}
                    </select>
                  </div>
                {%- endfor -%}
                <script type="application/json" data-variants>{{ product.variants | json }}</script>
              </div>
            {%- endunless -%}

          {%- when 'quantity_selector' -%}
            <div class="field product__quantity" {{ block.shopify_attributes }}>
              <label for="Quantity-{{ section.id }}">{{ 'products.product.quantity' | t }}</label>
              <input id="Quantity-{{ section.id }}" type="number" name="quantity" value="{{ current_variant.quantity_rule.min | default: 1 }}" min="{{ current_variant.quantity_rule.min | default: 1 }}"
                {%- if current_variant.quantity_rule.max %} max="{{ current_variant.quantity_rule.max }}"{% endif %} step="{{ current_variant.quantity_rule.increment | default: 1 }}" form="{{ form_id }}">
            </div>

          {%- when 'buy_buttons' -%}
            <div class="product__buy" id="Buy-{{ section.id }}" {{ block.shopify_attributes }}>
              {%- form 'product', product, id: form_id, class: 'product-form', novalidate: 'novalidate' -%}
                <input type="hidden" name="id" value="{{ current_variant.id }}" data-variant-id>
                <noscript>
                  {%- unless product.has_only_default_variant -%}
                    <div class="field">
                      <label for="NoJsVariant-{{ section.id }}">{{ 'products.product.variant' | t }}</label>
                      <select id="NoJsVariant-{{ section.id }}" name="id">
                        {%- for variant in product.variants -%}
                          <option value="{{ variant.id }}"{% if variant == current_variant %} selected{% endif %}{% unless variant.available %} disabled{% endunless %}>{{ variant.title | escape }} &ndash; {{ variant.price | money }}</option>
                        {%- endfor -%}
                      </select>
                    </div>
                  {%- endunless -%}
                </noscript>

                {%- if product.selling_plan_groups.size > 0 -%}
                  <fieldset class="selling-plans">
                    <legend>{{ 'products.product.purchase_options' | t }}</legend>
                    {%- unless product.requires_selling_plan -%}
                      <label class="radio"><input type="radio" name="selling_plan" value="" checked> {{ 'products.product.one_time_purchase' | t }}</label>
                    {%- endunless -%}
                    {%- for group in product.selling_plan_groups -%}
                      {%- for plan in group.selling_plans -%}
                        <label class="radio">
                          <input type="radio" name="selling_plan" value="{{ plan.id }}"{% if product.requires_selling_plan and forloop.parentloop.first and forloop.first %} checked{% endif %}>
                          {{ group.name | escape }} &ndash; {{ plan.name | escape }}
                        </label>
                      {%- endfor -%}
                    {%- endfor -%}
                  </fieldset>
                {%- endif -%}

                {%- if product.gift_card? and block.settings.show_gift_card_recipient -%}
                  <fieldset class="gift-card-recipient" data-gift-card-recipient>
                    <legend>{{ 'products.gift_card.recipient.legend' | t }}</legend>
                    <label class="checkbox">
                      <input type="checkbox" name="properties[__shopify_send_gift_card_to_recipient]" value="on" data-gift-card-toggle>
                      {{ 'products.gift_card.recipient.checkbox' | t }}
                    </label>
                    <div class="gift-card-recipient__fields">
                      <div class="field"><label for="Recipient-email-{{ section.id }}">{{ 'products.gift_card.recipient.email' | t }}</label><input id="Recipient-email-{{ section.id }}" type="email" name="properties[Recipient email]" disabled></div>
                      <div class="field"><label for="Recipient-name-{{ section.id }}">{{ 'products.gift_card.recipient.name' | t }}</label><input id="Recipient-name-{{ section.id }}" type="text" name="properties[Recipient name]" disabled></div>
                      <div class="field"><label for="Recipient-message-{{ section.id }}">{{ 'products.gift_card.recipient.message' | t }}</label><textarea id="Recipient-message-{{ section.id }}" name="properties[Message]" maxlength="200" rows="3" disabled></textarea></div>
                      <div class="field"><label for="Recipient-date-{{ section.id }}">{{ 'products.gift_card.recipient.send_on' | t }}</label><input id="Recipient-date-{{ section.id }}" type="date" name="properties[Send on]" pattern="\d{4}-\d{2}-\d{2}" disabled></div>
                    </div>
                  </fieldset>
                {%- endif -%}

                <button type="submit" name="add" class="btn btn--primary product-form__submit"{% unless current_variant.available %} disabled{% endunless %}>
                  {%- if current_variant.available -%}{{ 'products.product.add_to_cart' | t }}{%- else -%}{{ 'products.product.sold_out' | t }}{%- endif -%}
                </button>
                {%- if block.settings.show_dynamic_checkout -%}
                  {{ form | payment_button }}
                {%- endif -%}
              {%- endform -%}

              {%- assign pick_up_availabilities = current_variant.store_availabilities | where: 'pick_up_enabled', true -%}
              {%- if pick_up_availabilities.size > 0 -%}
                <div class="pickup">
                  {%- for availability in pick_up_availabilities -%}
                    <p>
                      {% render 'icon', icon: 'pin' %}
                      {%- if availability.available -%}
                        {{ 'products.product.pickup_available_html' | t: location: availability.location.name }}
                        <small>{{ availability.pick_up_time }}</small>
                      {%- else -%}
                        {{ 'products.product.pickup_unavailable_html' | t: location: availability.location.name }}
                      {%- endif -%}
                    </p>
                  {%- endfor -%}
                </div>
              {%- endif -%}
            </div>

          {%- when 'description' -%}
            {%- if product.description != blank -%}
              <div class="rte product__description" {{ block.shopify_attributes }}>{{ product.description }}</div>
            {%- endif -%}

          {%- when 'collapsible_tab' -%}
            <details class="accordion" {{ block.shopify_attributes }}>
              <summary>{{ block.settings.heading | escape }}{% render 'icon', icon: 'chevron' %}</summary>
              <div class="rte">{{ block.settings.content }}{{ block.settings.page.content }}</div>
            </details>

          {%- when 'share' -%}
            <p class="product__share" {{ block.shopify_attributes }}>
              <a href="https://www.facebook.com/sharer/sharer.php?u={{ request.origin | append: product.url | url_encode }}" target="_blank" rel="noopener">{{ 'general.social.share_facebook' | t }}</a>
              <a href="https://pinterest.com/pin/create/button/?url={{ request.origin | append: product.url | url_encode }}" target="_blank" rel="noopener">{{ 'general.social.share_pinterest' | t }}</a>
            </p>
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
  {{ product | structured_data }}
</section>

{% schema %}
{
  "name": "Product information",
  "tag": "div",
  "class": "section-main-product",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" }
  ],
  "blocks": [
    { "type": "@app" },
    { "type": "text", "name": "Text", "settings": [{ "type": "text", "id": "text", "label": "Text", "default": "Text block" }] },
    { "type": "title", "name": "Title", "limit": 1 },
    { "type": "price", "name": "Price", "limit": 1 },
    { "type": "variant_picker", "name": "Variant picker", "limit": 1 },
    { "type": "quantity_selector", "name": "Quantity selector", "limit": 1 },
    {
      "type": "buy_buttons", "name": "Buy buttons", "limit": 1,
      "settings": [
        { "type": "checkbox", "id": "show_dynamic_checkout", "label": "Show dynamic checkout buttons", "default": true },
        { "type": "checkbox", "id": "show_gift_card_recipient", "label": "Show gift card recipient form", "default": true }
      ]
    },
    { "type": "description", "name": "Description", "limit": 1 },
    {
      "type": "collapsible_tab", "name": "Collapsible tab",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Shipping & returns" },
        { "type": "richtext", "id": "content", "label": "Content" },
        { "type": "page", "id": "page", "label": "Content from page" }
      ]
    },
    { "type": "share", "name": "Share", "limit": 1 }
  ]
}
{% endschema %}
