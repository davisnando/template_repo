{%- paginate search.results by 16 -%}
  <section class="section search color-{{ section.settings.color_scheme }}">
    <div class="container">
      <div class="section__head">
        <h1 class="section__title">{{ 'general.search.title' | t }}</h1>
      </div>
      <form action="{{ routes.search_url }}" method="get" role="search" class="search-form search-form--page">
        <div class="field">
          <label for="SearchPage-input">{{ 'general.search.label' | t }}</label>
          <input id="SearchPage-input" type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'general.search.placeholder' | t }}">
        </div>
        <input type="hidden" name="options[prefix]" value="last">
        <button type="submit" class="btn btn--primary">{{ 'general.search.submit' | t }}</button>
      </form>
      {%- if search.performed -%}
        <p class="search__count" role="status">{{ 'general.search.results_with_count' | t: terms: search.terms, count: search.results_count }}</p>
        {%- if search.filters != empty -%}
          {%- capture clear_url -%}{{ routes.search_url }}?q={{ search.terms | escape }}&options[prefix]=last{%- endcapture -%}
          {% render 'facets', results: search, clear_url: clear_url %}
        {%- endif -%}
        <ul class="product-grid" role="list">
          {%- for item in search.results -%}
            <li>
              {%- case item.object_type -%}
                {%- when 'product' -%}
                  {% render 'product-card', product: item %}
                {%- else -%}
                  <a class="card card--text" href="{{ item.url }}">
                    <span class="eyebrow">{{ item.object_type | capitalize }}</span>
                    <h2 class="card__title">{{ item.title | escape }}</h2>
                    <p>{{ item.content | strip_html | truncatewords: 20 }}</p>
                  </a>
              {%- endcase -%}
            </li>
          {%- endfor -%}
        </ul>
        {% render 'pagination', paginate: paginate %}
      {%- endif -%}
    </div>
  </section>
{%- endpaginate -%}

{% schema %}
{
  "name": "Search results",
  "tag": "div",
  "class": "section-main-search",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" }
  ]
}
{% endschema %}
