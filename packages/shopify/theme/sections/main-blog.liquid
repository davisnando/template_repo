{%- paginate blog.articles by 9 -%}
  <section class="section blog color-{{ section.settings.color_scheme }}">
    <div class="container">
      <div class="section__head"><h1 class="section__title">{{ blog.title | escape }}</h1></div>
      {%- if blog.all_tags.size > 0 -%}
        <ul class="tags" role="list">
          <li><a class="pill" href="{{ blog.url }}"{% unless current_tags %} aria-current="page"{% endunless %}>{{ 'blogs.all' | t }}</a></li>
          {%- for tag in blog.all_tags -%}
            <li><a class="pill" href="{{ blog.url }}/tagged/{{ tag | handleize }}"{% if current_tags contains tag %} aria-current="page"{% endif %}>{{ tag | escape }}</a></li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
      <ul class="product-grid product-grid--3" role="list">
        {%- for article in blog.articles -%}
          <li class="card">
            <a class="card__link" href="{{ article.url }}">
              <div class="card__media card__media--wide">
                {%- if article.image -%}
                  {{ article.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '400, 600, 900', sizes: '(min-width: 990px) 33vw, 100vw' }}
                {%- else -%}
                  {{ 'image' | placeholder_svg_tag: 'placeholder' }}
                {%- endif -%}
              </div>
              <h2 class="card__title">{{ article.title | escape }}</h2>
            </a>
            <p class="card__meta">{{ article.published_at | time_tag: format: 'date' }}</p>
            <p>{{ article.excerpt_or_content | strip_html | truncatewords: 24 }}</p>
          </li>
        {%- endfor -%}
      </ul>
      {% render 'pagination', paginate: paginate %}
    </div>
  </section>
{%- endpaginate -%}

{% schema %}
{
  "name": "Blog posts",
  "tag": "div",
  "class": "section-main-blog",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" }
  ]
}
{% endschema %}
