<section class="section newsletter color-{{ section.settings.color_scheme }}">
  <div class="container container--narrow newsletter__inner">
    <h2 class="section__title">{{ section.settings.heading | escape }}</h2>
    {%- if section.settings.text != blank -%}<div class="section__intro rte">{{ section.settings.text }}</div>{%- endif -%}
    {%- assign form_id = 'NewsletterForm-' | append: section.id -%}
    {%- form 'customer', id: form_id, class: 'newsletter-form' -%}
      <input type="hidden" name="contact[tags]" value="newsletter">
      <div class="field">
        <label for="Newsletter-{{ section.id }}">{{ 'newsletter.label' | t }}</label>
        <input id="Newsletter-{{ section.id }}" type="email" name="contact[email]" autocomplete="email" required>
      </div>
      <button type="submit" class="btn btn--primary">{{ 'newsletter.button' | t }}</button>
      {%- if form.posted_successfully? -%}<p class="form__ok" role="status">{{ 'newsletter.success' | t }}</p>{%- endif -%}
      {%- if form.errors -%}<p class="form__error" role="alert">{{ form.errors.messages.email }}</p>{%- endif -%}
    {%- endform -%}
  </div>
</section>

{% schema %}
{
  "name": "Newsletter",
  "tag": "div",
  "class": "section-newsletter",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Join our newsletter" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>News, offers and events — no spam.</p>" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-2" }
  ],
  "presets": [{ "name": "Newsletter" }]
}
{% endschema %}
