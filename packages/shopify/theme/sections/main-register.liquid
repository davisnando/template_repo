<section class="section customer color-{{ section.settings.color_scheme }}">
  <div class="container container--narrow">
    <h1 class="section__title">{{ 'customer.register.title' | t }}</h1>
    {%- form 'create_customer', novalidate: 'novalidate', class: 'customer__form' -%}
      {%- if form.errors -%}<div class="form__errors" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
      <div class="field"><label for="RegisterFirstName">{{ 'customer.register.first_name' | t }}</label><input id="RegisterFirstName" type="text" name="customer[first_name]" autocomplete="given-name"></div>
      <div class="field"><label for="RegisterLastName">{{ 'customer.register.last_name' | t }}</label><input id="RegisterLastName" type="text" name="customer[last_name]" autocomplete="family-name"></div>
      <div class="field"><label for="RegisterEmail">{{ 'customer.login.email' | t }}</label><input id="RegisterEmail" type="email" name="customer[email]" autocomplete="email" required></div>
      <div class="field"><label for="RegisterPassword">{{ 'customer.login.password' | t }}</label><input id="RegisterPassword" type="password" name="customer[password]" autocomplete="new-password" required></div>
      <button type="submit" class="btn btn--primary">{{ 'customer.register.submit' | t }}</button>
    {%- endform -%}
  </div>
</section>

{% schema %}
{
  "name": "Customer register",
  "tag": "div",
  "class": "section-main-register",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" }
  ]
}
{% endschema %}
