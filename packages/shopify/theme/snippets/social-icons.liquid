<ul class="socials" role="list">
  {%- if settings.social_instagram_link != blank -%}<li><a href="{{ settings.social_instagram_link }}" rel="noopener" target="_blank">{{ 'general.social.instagram' | t }}</a></li>{%- endif -%}
  {%- if settings.social_facebook_link != blank -%}<li><a href="{{ settings.social_facebook_link }}" rel="noopener" target="_blank">{{ 'general.social.facebook' | t }}</a></li>{%- endif -%}
  {%- if settings.social_tiktok_link != blank -%}<li><a href="{{ settings.social_tiktok_link }}" rel="noopener" target="_blank">{{ 'general.social.tiktok' | t }}</a></li>{%- endif -%}
  {%- if settings.social_x_link != blank -%}<li><a href="{{ settings.social_x_link }}" rel="noopener" target="_blank">{{ 'general.social.x' | t }}</a></li>{%- endif -%}
  {%- if settings.social_youtube_link != blank -%}<li><a href="{{ settings.social_youtube_link }}" rel="noopener" target="_blank">{{ 'general.social.youtube' | t }}</a></li>{%- endif -%}
  {%- if settings.social_pinterest_link != blank -%}<li><a href="{{ settings.social_pinterest_link }}" rel="noopener" target="_blank">{{ 'general.social.pinterest' | t }}</a></li>{%- endif -%}
  {%- if settings.social_linkedin_link != blank -%}<li><a href="{{ settings.social_linkedin_link }}" rel="noopener" target="_blank">{{ 'general.social.linkedin' | t }}</a></li>{%- endif -%}
</ul>
